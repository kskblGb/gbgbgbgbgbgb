local function createSideButton(name)
    local wrapper = Instance.new("Frame")
    wrapper.Size = UDim2.new(1, 0, 0, 32)
    wrapper.BackgroundTransparency = 1
    wrapper.ZIndex = 6
    wrapper.Parent = sidebar

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 0, 16)
    bar.Position = UDim2.new(0, 0, 0.5, -8)
    bar.BackgroundColor3 = THEME.ACCENT
    bar.BorderSizePixel = 0
    bar.ZIndex = 8
    bar.Visible = false
    bar.Parent = wrapper

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(1, 0)
    bc.Parent = bar

    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 1, 0)
    b.BackgroundColor3 = THEME.SIDEBAR
    b.Text = name
    b.TextColor3 = THEME.SUBTEXT
    b.TextSize = 13
    b.Font = Enum.Font.GothamMedium
    b.BorderSizePixel = 0
    b.ZIndex = 7
    b.Parent = wrapper

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = b

    b.MouseButton1Click:Connect(function()
        switchPage(name)
        for _, o in ipairs(sideButtons) do
            o.btn.BackgroundColor3 = THEME.SIDEBAR
            o.btn.TextColor3 = THEME.SUBTEXT
            o.bar.Visible = false
        end
        b.BackgroundColor3 = THEME.BG
        b.TextColor3 = THEME.TEXT
        bar.Visible = true
    end)
    table.insert(sideButtons, { btn = b, bar = bar })
    return b
end

