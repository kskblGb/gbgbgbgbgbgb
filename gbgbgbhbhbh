local flyDragging = false
local function updateFlySpeed(x)
    local rel = (x - flyBar.AbsolutePosition.X) / flyBar.AbsoluteSize.X
    if rel < 0 then rel = 0 elseif rel > 1 then rel = 1 end
    flyFill.Size = UDim2.new(rel, 0, 1, 0)
    local v = math.floor(10 + (300 - 10) * rel + 0.5)
    Config.FlySpeed = v
    flySpeedLabel.Text = "速度: " .. v
end

flyBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        flyDragging = true
        updateFlySpeed(input.Position.X)
    end
end)
UIS.InputChanged:Connect(function(input)
    if flyDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        updateFlySpeed(input.Position.X)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        flyDragging = false
    end
end)

